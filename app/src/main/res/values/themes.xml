<resources>
    <style name="Theme.Tuklas" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
    <style name="Theme.Tuklas.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tuklastayo_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/tuklastayo_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Tuklas</item>
        <item name="android:statusBarColor">@color/tuklastayo_splash_background</item>
        <item name="android:navigationBarColor">@color/tuklastayo_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
